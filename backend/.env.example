# Copie ce fichier en .env (jamais committé, voir .gitignore) et remplis
# de vraies valeurs. Ces mêmes noms de variables doivent être configurés en
# secrets GitHub Actions / sur la plateforme d'hébergement pour la prod
# (voir CLAUDE.md > Continuous Integration).

NODE_ENV=development
PORT=3000

# Backend Express dev en local répondant sur http://localhost:3000/api,
# ce qui correspond à ApiConstants._devBaseUrl côté app Flutter.
MONGODB_URI=mongodb://localhost:27017/lahiyarouwa

# Secret de signature des JWT — génère une valeur aléatoire longue,
# différente en dev et en prod, jamais réutilisée/committée.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Origine autorisée en CORS pour le futur frontend admin-web.
CORS_ORIGIN=http://localhost:5173
