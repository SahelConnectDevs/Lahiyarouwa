# Copie ce fichier en .env (jamais committé, voir .gitignore) et remplis
# de vraies valeurs. Sur le VPS, le fichier vit dans
# /var/www/api.lahiyarouwadayaro.com/shared/.env (voir README.md).

NODE_ENV=development
PORT=3000

# En local : MongoDB installé sur la machine. En prod : l'URI MongoDB Atlas
# (mongodb+srv://...), avec l'IP du VPS autorisée dans Atlas > Network Access.
MONGODB_URI=mongodb://localhost:27017/lahiyarouwa

# Secret de signature des JWT — génère une valeur aléatoire longue,
# différente en dev et en prod, jamais réutilisée/committée :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Origine(s) autorisée(s) en CORS pour l'admin-web, séparées par des virgules.
# En prod : https://admin.lahiyarouwadayaro.com (jamais * en prod).
CORS_ORIGIN=http://localhost:5173

# Nombre de proxies devant l'API : 1 derrière nginx sur le VPS, 0 en local.
TRUST_PROXY=0

# Adresse de l'espace web (admin + agents), utilisée dans les liens envoyés
# par e-mail (mot de passe oublié). En local : http://localhost:5173
WEB_APP_URL=https://admin.lahiyarouwadayaro.com

# Envoi des codes de connexion par e-mail (double authentification des
# admins), via le relais SMTP de Brevo (smtp-relay.brevo.com, port 587).
# Dans Brevo > SMTP & API > onglet SMTP : SMTP_USER = l'« identifiant »
# affiché (xxxx@smtp-brevo.com), SMTP_PASS = une « clé SMTP » générée sur
# cette page — jamais le mot de passe du compte Brevo. MAIL_FROM doit être
# un expéditeur validé dans Brevo (Expéditeurs, domaines et IP dédiées).
# Laisser SMTP_HOST vide en local : les codes s'affichent alors dans la
# console de `npm run dev`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lahiyar Ouwa Da Yaro <smtpsahelconnect@gmail.com>"
