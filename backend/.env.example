# Copie ce fichier en .env (jamais committé, voir .gitignore) et remplis
# de vraies valeurs. Sur le VPS, le fichier vit dans
# /var/www/api.lahiyarouwadayaro.com/shared/.env (voir README.md).

NODE_ENV=development
PORT=3000

# En local : MongoDB installé sur la machine. En prod : l'URI MongoDB Atlas
# (mongodb+srv://...), avec l'IP du VPS autorisée dans Atlas > Network Access.
MONGODB_URI=mongodb://localhost:27017/lahiyarouwa

# Secret de signature des JWT — génère une valeur aléatoire longue,
# différente en dev et en prod, jamais réutilisée/committée :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Origine(s) autorisée(s) en CORS pour l'admin-web, séparées par des virgules.
# En prod : https://admin.lahiyarouwadayaro.com (jamais * en prod).
CORS_ORIGIN=http://localhost:5173

# Nombre de proxies devant l'API : 1 derrière nginx sur le VPS, 0 en local.
TRUST_PROXY=0
